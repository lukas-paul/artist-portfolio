# Sanity project — from https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Server-side read token with "Viewer" access — used for draft mode,
# the Live Content API, and reading unpublished/private data.
# Create one at https://www.sanity.io/manage -> API -> Tokens
SANITY_API_READ_TOKEN=
